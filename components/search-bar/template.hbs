{{!--
  A search box that submits to the plugin's /search results page. The input is
  named `q`, so a GET submit lands on /search?q=… which Neleto routes to this
  plugin's search page.
--}}
<form class="ss-bar" role="search" action="/search" method="get">
    <input
        class="ss-bar__input"
        type="search"
        name="q"
        aria-label="{{#if properties.placeholder}}{{ properties.placeholder }}{{else}}Suchen{{/if}}"
        placeholder="{{#if properties.placeholder}}{{ properties.placeholder }}{{else}}Suchen…{{/if}}" />
    <button class="ss-bar__button" type="submit">
        {{#if properties.button_label}}{{ properties.button_label }}{{else}}Suchen{{/if}}
    </button>
</form>
